            if (!p1Name || !p2Name || !p1Dob || !p2Dob) {
                errorMsg.classList.remove('hidden');
                return;
            }
            errorMsg.classList.add('hidden');

            // Show Loading Screen
            document.getElementById('inputForm').classList.add('hidden');
            document.getElementById('loadingScreen').classList.remove('hidden');

            // Animate progress steps
            let progress = 0;
            const progressBar = document.getElementById('progressBar');
            const loadingText = document.getElementById('loadingText');
            const loadingSubtext = document.getElementById('loadingSubtext');

            const steps = [
                { p: 25, title: "Calculating Name Phonetics...", sub: "Mapping soulmate frequencies" },
                { p: 50, title: "Reading Zodiac Stars...", sub: "Aligning planetary orbits & elements" },
                { p: 75, title: "Checking Numerology Birth Path...", sub: "Syncing life path numbers" },
                { p: 100, title: "Finalizing Love Score...", sub: "Preparing detailed match report" }
            ];

            let stepIdx = 0;
            const interval = setInterval(() => {
                if (stepIdx < steps.length) {
                    progressBar.style.width = steps[stepIdx].p + '%';
                    loadingText.innerText = steps[stepIdx].title;
                    loadingSubtext.innerText = steps[stepIdx].sub;
                    stepIdx++;
                } else {
                    clearInterval(interval);
                    setTimeout(showResults, 500);
                }
            }, 600);
        }

        function computeDetailedScores() {
            const p1Name = document.getElementById('p1Name').value.trim().toLowerCase();
            const p2Name = document.getElementById('p2Name').value.trim().toLowerCase();
            
            const p1Dob = new Date(document.getElementById('p1Dob').value);
            const p2Dob = new Date(document.getElementById('p2Dob').value);

            const p1Zodiac = document.getElementById('p1Zodiac').value;
            const p2Zodiac = document.getElementById('p2Zodiac').value;

            const p1Blood = document.getElementById('p1Blood').value;
            const p2Blood = document.getElementById('p2Blood').value;

            const p1Hobby = document.getElementById('p1Hobby').value;
            const p2Hobby = document.getElementById('p2Hobby').value;

            // 1. Name Match Score (ASCII Hash & common letters)
            let nameSum = 0;
            const combinedNames = p1Name + "loves" + p2Name;
            for (let i = 0; i < combinedNames.length; i++) {
                nameSum += combinedNames.charCodeAt(i);
            }
            const nameScore = 60 + (nameSum % 38); // 60% to 97%

            // 2. Zodiac Score Matrix (Simplistic & Fun)
            const elements = {
                Aries: "Fire", Leo: "Fire", Sagittarius: "Fire",
                Taurus: "Earth", Virgo: "Earth", Capricorn: "Earth",
                Gemini: "Air", Libra: "Air", Aquarius: "Air",
                Cancer: "Water", Scorpio: "Water", Pisces: "Water"
            };

            let zodiacScore = 70;
            if (elements[p1Zodiac] === elements[p2Zodiac]) {
                zodiacScore = 95; // Same element
            } else if (
                (elements[p1Zodiac] === "Fire" && elements[p2Zodiac] === "Air") ||
                (elements[p1Zodiac] === "Air" && elements[p2Zodiac] === "Fire") ||
                (elements[p1Zodiac] === "Earth" && elements[p2Zodiac] === "Water") ||
                (elements[p1Zodiac] === "Water" && elements[p2Zodiac] === "Earth")
            ) {
                zodiacScore = 90; // Complementary element
            } else {
                zodiacScore = 75;
            }

            // 3. Numerology Life Path Match
            const getLifePath = (d) => {
                const digits = d.toISOString().replace(/\D/g, '');
                let sum = digits.split('').reduce((a, b) => parseInt(a) + parseInt(b), 0);
                while (sum > 9 && sum !== 11 && sum !== 22) {
                    sum = sum.toString().split('').reduce((a, b) => parseInt(a) + parseInt(b), 0);
                }
                return sum;
            };

            const lp1 = getLifePath(p1Dob);
            const lp2 = getLifePath(p2Dob);
            const numDiff = Math.abs(lp1 - lp2);
            const numScore = Math.max(65, 100 - (numDiff * 7));

            // 4. Blood Type Synergy
            let bloodScore = 80;
            if (p1Blood === p2Blood) bloodScore = 88;
            if ((p1Blood === 'O' && p2Blood === 'A') || (p1Blood === 'A' && p2Blood === 'O')) bloodScore = 94;
            if ((p1Blood === 'AB' && p2Blood === 'B') || (p1Blood === 'B' && p2Blood === 'AB')) bloodScore = 91;

            // 5. Hobby Score
            const hobbyScore = (p1Hobby === p2Hobby) ? 98 : 82;

            // 6. Chinese Zodiac Compatibility
            const y1 = p1Dob.getFullYear();
            const y2 = p2Dob.getFullYear();
            const cnZ1 = getChineseZodiac(y1);
            const cnZ2 = getChineseZodiac(y2);
            const cnZodiacScore = ((Math.abs(y1 - y2) % 4) === 0) ? 96 : 84;

            // Weighted Total
            const finalScore = Math.round(
                (nameScore * 0.20) +
                (zodiacScore * 0.25) +
                (numScore * 0.20) +
                (bloodScore * 0.10) +
                (hobbyScore * 0.15) +
                (cnZodiacScore * 0.10)
            );

            return {
                finalScore,
                nameScore,
                zodiacScore,
                numScore,
                bloodScore,
                hobbyScore,
                cnZodiacScore
            };
        }

        function showResults() {
            document.getElementById('loadingScreen').classList.add('hidden');
            document.getElementById('resultScreen').classList.remove('hidden');

            const p1Name = document.getElementById('p1Name').value.trim();
            const p2Name = document.getElementById('p2Name').value.trim();

            document.getElementById('resP1Name').innerText = p1Name;
            document.getElementById('resP2Name').innerText = p2Name;

            const scores = computeDetailedScores();

            // Set Breakdown Text
            document.getElementById('nameScore').innerText = scores.nameScore + "%";
            document.getElementById('zodiacScore').innerText = scores.zodiacScore + "%";
            document.getElementById('numScore').innerText = scores.numScore + "%";
            document.getElementById('bloodScore').innerText = scores.bloodScore + "%";
            document.getElementById('hobbyScore').innerText = scores.hobbyScore + "%";
            document.getElementById('cnZodiacScore').innerText = scores.cnZodiacScore + "%";

