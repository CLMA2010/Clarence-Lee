                badge.innerText = "🌟 Sweet Match with Fun Chemistry!";
                badge.className = "mt-2 inline-block px-4 py-1 rounded-full text-sm font-bold bg-purple-500 text-white shadow-md";
                desc.innerText = `Good potential! While you both bring unique and different perspectives into the relationship, your opposites attract energy creates excitement!`;
                tip.innerText = "Patience and understanding differences will turn small hurdles into memorable bonding moments.";
            } else {
                badge.innerText = "🔥 Passionate & Challenging Adventure!";
                badge.className = "mt-2 inline-block px-4 py-1 rounded-full text-sm font-bold bg-indigo-500 text-white shadow-md";
                desc.innerText = `${p1Name} and ${p2Name} have a unique bond that requires extra effort and open communication to balance out your different energies.`;
                tip.innerText = "Focus on active listening and discovering shared hobbies together!";
            }
